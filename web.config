<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        
        <!-- ============================================ -->
        <!-- Static Content Caching -->
        <!-- ============================================ -->
        <staticContent>
            <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
            
            <!-- Add WebP MIME type -->
            <remove fileExtension=".webp" />
            <mimeMap fileExtension=".webp" mimeType="image/webp" />
        </staticContent>
        
        <!-- ============================================ -->
        <!-- HTTP Response Headers -->
        <!-- ============================================ -->
        <httpProtocol>
            <customHeaders>
                <remove name="X-Powered-By" />
            </customHeaders>
        </httpProtocol>
        
        <!-- ============================================ -->
        <!-- URL Rewrite for WebP Images -->
        <!-- ============================================ -->
        <rewrite>
            <rules>
                <rule name="Serve WebP" stopProcessing="true">
                    <match url="^(.*)\.(jpe?g|png)$" />
                    <conditions logicalGrouping="MatchAll">
                        <add input="{HTTP_ACCEPT}" pattern="image/webp" />
                        <add input="{REQUEST_FILENAME}.webp" matchType="IsFile" />
                    </conditions>
                    <action type="Rewrite" url="{R:1}.webp" />
                </rule>
            </rules>
            <outboundRules>
                <rule name="Add Vary Header for WebP">
                    <match serverVariable="RESPONSE_Vary" pattern=".*" />
                    <conditions>
                        <add input="{REQUEST_URI}" pattern="\.(jpe?g|png)$" />
                    </conditions>
                    <action type="Rewrite" value="Accept" />
                </rule>
            </outboundRules>
        </rewrite>
        
        <!-- ============================================ -->
        <!-- GZip Compression -->
        <!-- ============================================ -->
        <httpCompression>
            <dynamicTypes>
                <clear />
                <add enabled="true" mimeType="text/*"/>
                <add enabled="true" mimeType="message/*"/>
                <add enabled="true" mimeType="application/x-javascript"/>
                <add enabled="true" mimeType="application/javascript"/>
                <add enabled="true" mimeType="application/json"/>
                <add enabled="false" mimeType="*/*"/>
                <add enabled="true" mimeType="application/atom+xml"/>
                <add enabled="true" mimeType="application/atom+xml;charset=utf-8"/>
            </dynamicTypes>
            <staticTypes>
                <clear />
                <add enabled="true" mimeType="text/*"/>
                <add enabled="true" mimeType="message/*"/>
                <add enabled="true" mimeType="application/javascript"/>
                <add enabled="true" mimeType="application/atom+xml"/>
                <add enabled="true" mimeType="application/xaml+xml"/>
                <add enabled="true" mimeType="application/json"/>
                <add enabled="false" mimeType="*/*"/>
            </staticTypes>
        </httpCompression>
        
        <!-- ============================================ -->
        <!-- Detailed Cache Control by Extension -->
        <!-- ============================================ -->
        <outboundRules>
            <!-- Images - 1 year -->
            <rule name="Set Cache-Control for Images">
                <match serverVariable="RESPONSE_Cache-Control" pattern=".*" />
                <conditions>
                    <add input="{REQUEST_URI}" pattern="\.(jpg|jpeg|png|gif|webp|svg|ico)$" />
                </conditions>
                <action type="Rewrite" value="public, max-age=31536000, immutable" />
            </rule>
            
            <!-- CSS/JS - 1 month -->
            <rule name="Set Cache-Control for CSS/JS">
                <match serverVariable="RESPONSE_Cache-Control" pattern=".*" />
                <conditions>
                    <add input="{REQUEST_URI}" pattern="\.(css|js)$" />
                </conditions>
                <action type="Rewrite" value="public, max-age=2592000" />
            </rule>
            
            <!-- Fonts - 1 year -->
            <rule name="Set Cache-Control for Fonts">
                <match serverVariable="RESPONSE_Cache-Control" pattern=".*" />
                <conditions>
                    <add input="{REQUEST_URI}" pattern="\.(ttf|otf|woff|woff2)$" />
                </conditions>
                <action type="Rewrite" value="public, max-age=31536000, immutable" />
            </rule>
        </outboundRules>
        
    </system.webServer>
</configuration>
